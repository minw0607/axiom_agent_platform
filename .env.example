# Copy to .env and fill in. Never commit .env.
# AXIOM_MODE=demo needs no keys: recorded model responses and TF-IDF retrieval.
AXIOM_MODE=demo
MODEL_ALIAS_MAP=

# Real-model runs only
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Services
DATABASE_URL=postgresql://axiom:axiom@postgres:5432/axiom
MLFLOW_TRACKING_URI=http://mlflow:5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
REGULUS_MCP_URL=http://regulus-mcp:8001/mcp
GKN_MCP_URL=http://gkn-mcp:8002/mcp
# Required by docker compose. Generate one with: openssl rand -hex 32
MCP_SHARED_SECRET=

# Role-scoped API keys, comma-separated
SUBMITTER_API_KEYS=
REVIEWER_API_KEYS=
AUDITOR_API_KEYS=
