# Copy to .env and fill in. Never commit .env.
# AXIOM_MODE=demo needs no keys: recorded model responses and TF-IDF retrieval.
AXIOM_MODE=demo
# Local mode only: logical alias -> provider:deployment. Real names stay here, never in the repo.
#   MODEL_ALIAS_MAP=small-a=openai:<deployment>,frontier-a=openai:<deployment>
MODEL_ALIAS_MAP=
# Set to 1 in local mode to save live responses under data/recorded/ for the demo.
AXIOM_RECORD=

# Real-model runs only
OPENAI_API_KEY=
# Optional: a compatible endpoint or gateway. Setting OPENAI_API_VERSION switches to Azure OpenAI.
OPENAI_BASE_URL=
OPENAI_API_VERSION=
# Optional: an API management gateway's subscription header.
OPENAI_APIM_HEADER_NAME=
OPENAI_APIM_SUBSCRIPTION_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Services
DATABASE_URL=postgresql://axiom:axiom@postgres:5432/axiom
MLFLOW_TRACKING_URI=http://mlflow:5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
REGULUS_MCP_URL=http://regulus-mcp:8001/mcp
GKN_MCP_URL=http://gkn-mcp:8002/mcp
# Required by docker compose. Generate one with: openssl rand -hex 32
MCP_SHARED_SECRET=

# Role-scoped API keys: comma-separated name:key pairs, for example
#   SUBMITTER_API_KEYS=rm-alex:<random key>
# Generate a key with: openssl rand -hex 24
SUBMITTER_API_KEYS=
REVIEWER_API_KEYS=
AUDITOR_API_KEYS=
